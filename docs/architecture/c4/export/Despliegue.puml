@startuml
title <size:24>Deployment View: San Camilo en Línea - Producción</size>\n<size:24>Despliegue en producción (MVP): celular, VPS y Docker Compose.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.Celulardelusuario, "Celular del usuario", $type="Android + Chrome", $descr="Dispositivo de gama baja (R-05)", $tags="", $link="") {
  Container(Producción.Celulardelusuario.Aplicaciónwebprogresiva_1, "Aplicación web progresiva", $techn="HTML/CSS/JavaScript + Service Worker", $descr="Interfaz móvil para clientes, comerciantes y repartidores; solo por HTTPS. [QA08-01, QA08-06]", $tags="", $link="")
}

Deployment_Node(Producción.ServidorVPSenlanube, "Servidor VPS en la nube", $type="Ubuntu 24.04 LTS, 2 vCPU, 4 GB RAM", $descr="Un único servidor para el MVP (ADR-001, R-03)", $tags="", $link="") {
  Deployment_Node(Producción.ServidorVPSenlanube.DockerCompose, "Docker Compose", $type="Docker 27", $descr="Ejecuta los contenedores del MVP", $tags="", $link="") {
    Container(Producción.ServidorVPSenlanube.DockerCompose.AplicaciónwebAPI_1, "Aplicación web / API", $techn="Python / Django (HTTP/JSON)", $descr="Monolito modular (ADR-001); filtra por mercado_id de la sesión, cobra con clave de idempotencia y lee las reglas de cada mercado. [QA08-01, QA08-02, QA08-04, QA08-05, QA08-07]", $tags="", $link="")
    Container(Producción.ServidorVPSenlanube.DockerCompose.Workerdenotificacionesyconciliación_1, "Worker de notificaciones y conciliación", $techn="Python / Celery", $descr="Reintenta avisos sin bloquear el pago y concilia cada 5 min los cobros en PENDIENTE (ADR-007). [QA08-03, QA08-04]", $tags="", $link="")
    ContainerDb(Producción.ServidorVPSenlanube.DockerCompose.Basededatosrelacional_1, "Base de datos relacional", $techn="PostgreSQL 16", $descr="Una sola base para los tres mercados: tablas con mercado_id (ADR-006) e intentos_pago con clave de idempotencia (ADR-007). [QA08-04, QA08-05]", $tags="", $link="")
    ContainerQueue(Producción.ServidorVPSenlanube.DockerCompose.Colaycaché_1, "Cola y caché", $techn="Redis", $descr="Cola de tareas de Celery y caché del catálogo. [QA08-01, QA08-03]", $tags="", $link="")
  }

}

Rel(Producción.Celulardelusuario.Aplicaciónwebprogresiva_1, Producción.ServidorVPSenlanube.DockerCompose.AplicaciónwebAPI_1, "Envía solicitudes y recibe respuestas", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Producción.ServidorVPSenlanube.DockerCompose.Workerdenotificacionesyconciliación_1, Producción.ServidorVPSenlanube.DockerCompose.AplicaciónwebAPI_1, "Ejecuta tareas del módulo Notificaciones", $techn="Celery/Python", $tags="", $link="")
Rel(Producción.ServidorVPSenlanube.DockerCompose.AplicaciónwebAPI_1, Producción.ServidorVPSenlanube.DockerCompose.Basededatosrelacional_1, "Lee y registra datos de negocio", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.ServidorVPSenlanube.DockerCompose.Workerdenotificacionesyconciliación_1, Producción.ServidorVPSenlanube.DockerCompose.Basededatosrelacional_1, "Lee y actualiza intentos_pago en PENDIENTE [QA08-04]", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.ServidorVPSenlanube.DockerCompose.AplicaciónwebAPI_1, Producción.ServidorVPSenlanube.DockerCompose.Colaycaché_1, "Encola notificaciones y utiliza caché", $techn="Protocolo Redis/TCP", $tags="", $link="")
Rel(Producción.ServidorVPSenlanube.DockerCompose.Workerdenotificacionesyconciliación_1, Producción.ServidorVPSenlanube.DockerCompose.Colaycaché_1, "Consume tareas y registra reintentos", $techn="Protocolo Redis/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml