@startuml
title <size:24>Container View: San Camilo en Línea</size>\n<size:24>Nivel 2 (Lab 08): contenedores con los escenarios que atiende cada uno [QA08-xx].</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Cliente, "Cliente", $descr="Consulta productos, compra en varios puestos y paga un pedido único.", $tags="", $link="")
Person(Comerciante, "Comerciante", $descr="Administra productos y prepara los pedidos de su puesto en uno de los tres mercados.", $tags="", $link="")
Person(Repartidor, "Repartidor", $descr="Consulta pedidos de delivery y actualiza su entrega.", $tags="", $link="")
System(PasareladepagoYape, "Pasarela de pago Yape", $descr="Proveedor externo utilizado mediante la interfaz PasarelaPago; integración abstracta en el MVP.", $tags="", $link="")
System(ServiciodeWhatsApp, "Servicio de WhatsApp", $descr="Servicio externo al que se envían las confirmaciones y notificaciones.", $tags="", $link="")

System_Boundary("SanCamiloenLínea_boundary", "San Camilo en Línea", $tags="") {
  Container(SanCamiloenLínea.Workerdenotificacionesyconciliación, "Worker de notificaciones y conciliación", $techn="Python / Celery", $descr="Reintenta avisos sin bloquear el pago y concilia cada 5 min los cobros en PENDIENTE (ADR-007). [QA08-03, QA08-04]", $tags="", $link="")
  ContainerDb(SanCamiloenLínea.Basededatosrelacional, "Base de datos relacional", $techn="PostgreSQL 16", $descr="Una sola base para los tres mercados: tablas con mercado_id (ADR-006) e intentos_pago con clave de idempotencia (ADR-007). [QA08-04, QA08-05]", $tags="", $link="")
  ContainerQueue(SanCamiloenLínea.Colaycaché, "Cola y caché", $techn="Redis", $descr="Cola de tareas de Celery y caché del catálogo. [QA08-01, QA08-03]", $tags="", $link="")
  Container(SanCamiloenLínea.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="HTML/CSS/JavaScript + Service Worker", $descr="Interfaz móvil para clientes, comerciantes y repartidores; solo por HTTPS. [QA08-01, QA08-06]", $tags="", $link="")
  Container(SanCamiloenLínea.AplicaciónwebAPI, "Aplicación web / API", $techn="Python / Django (HTTP/JSON)", $descr="Monolito modular (ADR-001); filtra por mercado_id de la sesión, cobra con clave de idempotencia y lee las reglas de cada mercado. [QA08-01, QA08-02, QA08-04, QA08-05, QA08-07]", $tags="", $link="")
}

Rel(Cliente, SanCamiloenLínea.Aplicaciónwebprogresiva, "Realiza sus compras", $techn="HTTPS", $tags="", $link="")
Rel(Comerciante, SanCamiloenLínea.Aplicaciónwebprogresiva, "Gestiona su puesto", $techn="HTTPS", $tags="", $link="")
Rel(Repartidor, SanCamiloenLínea.Aplicaciónwebprogresiva, "Consulta y actualiza entregas", $techn="HTTPS", $tags="", $link="")
Rel(SanCamiloenLínea.Aplicaciónwebprogresiva, SanCamiloenLínea.AplicaciónwebAPI, "Envía solicitudes y recibe respuestas", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI, SanCamiloenLínea.Basededatosrelacional, "Lee y registra datos de negocio", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI, SanCamiloenLínea.Colaycaché, "Encola notificaciones y utiliza caché", $techn="Protocolo Redis/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.Colaycaché, "Consume tareas y registra reintentos", $techn="Protocolo Redis/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, ServiciodeWhatsApp, "Envía mensajes y confirmaciones", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI, PasareladepagoYape, "Solicita cobros con clave de idempotencia [QA08-04]", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.Basededatosrelacional, "Lee y actualiza intentos_pago en PENDIENTE [QA08-04]", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, PasareladepagoYape, "Consulta el estado de cobros pendientes por clave [QA08-04]", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.AplicaciónwebAPI, "Ejecuta tareas del módulo Notificaciones", $techn="Celery/Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI, ServiciodeWhatsApp, "Envía notificaciones del pedido", $techn="HTTPS/JSON", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml