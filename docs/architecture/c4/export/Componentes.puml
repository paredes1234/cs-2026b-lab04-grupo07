@startuml
title <size:24>Component View: San Camilo en Línea - Aplicación web / API</size>\n<size:24>Nivel 3: componentes internos de la API, alineados con paquetes.puml (Lab 05).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(PasareladepagoYape, "Pasarela de pago Yape", $descr="Proveedor externo utilizado mediante la interfaz PasarelaPago; integración abstracta en el MVP.", $tags="", $link="")
System(ServiciodeWhatsApp, "Servicio de WhatsApp", $descr="Servicio externo al que se envían las confirmaciones y notificaciones.", $tags="", $link="")

System_Boundary("SanCamiloenLínea_boundary", "San Camilo en Línea", $tags="") {
  Container_Boundary("SanCamiloenLínea.AplicaciónwebAPI_boundary", "Aplicación web / API", $tags="") {
    Component(SanCamiloenLínea.AplicaciónwebAPI.Notificaciones, "Notificaciones", $techn="Módulo Python/Django", $descr="Implementa Notificador y coordina el envío asíncrono de avisos al comerciante (ADR-003). [QA08-03]", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Entrega, "Entrega", $techn="Módulo Python/Django", $descr="Gestiona recojo, delivery y estado de PedidoPuesto según las reglas del mercado. [QA08-07]", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Mercados, "Mercados", $techn="Módulo Python + JSON", $descr="Reglas comerciales de cada mercado cargadas desde mercados.json; único punto de entrada RegistroMercados (ADR-008). [QA08-07, QA08-08]", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Compartido", $techn="Módulo Python/Django", $descr="Tipos, identificadores y utilidades sin dependencias de los módulos de negocio.", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Catálogo, "Catálogo", $techn="Módulo Python/Django", $descr="Gestiona puestos, productos, disponibilidad y stock por mercado. [QA08-01, QA08-07]", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, "Pedidos", $techn="Módulo Python/Django", $descr="Carrito, pedido multipuesto, Pedido y PedidoPuesto; dueño del puerto Notificador; toda consulta usa WHERE id = ? AND mercado_id = ? (ADR-006). [QA08-02, QA08-05]", $tags="", $link="")
    Component(SanCamiloenLínea.AplicaciónwebAPI.Pagos, "Pagos", $techn="Módulo Python/Django", $descr="Cobra mediante PuertoPago y el adaptador Yape; Decorator idempotente con registro PENDIENTE y consulta antes de reintentar (ADR-007). [QA08-04]", $tags="", $link="")
  }

  Container(SanCamiloenLínea.Workerdenotificacionesyconciliación, "Worker de notificaciones y conciliación", $techn="Python / Celery", $descr="Reintenta avisos sin bloquear el pago y concilia cada 5 min los cobros en PENDIENTE (ADR-007). [QA08-03, QA08-04]", $tags="", $link="")
  ContainerDb(SanCamiloenLínea.Basededatosrelacional, "Base de datos relacional", $techn="PostgreSQL 16", $descr="Una sola base para los tres mercados: tablas con mercado_id (ADR-006) e intentos_pago con clave de idempotencia (ADR-007). [QA08-04, QA08-05]", $tags="", $link="")
  ContainerQueue(SanCamiloenLínea.Colaycaché, "Cola y caché", $techn="Redis", $descr="Cola de tareas de Celery y caché del catálogo. [QA08-01, QA08-03]", $tags="", $link="")
  Container(SanCamiloenLínea.Aplicaciónwebprogresiva, "Aplicación web progresiva", $techn="HTML/CSS/JavaScript + Service Worker", $descr="Interfaz móvil para clientes, comerciantes y repartidores; solo por HTTPS. [QA08-01, QA08-06]", $tags="", $link="")
}

Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.Colaycaché, "Consume tareas y registra reintentos", $techn="Protocolo Redis/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, ServiciodeWhatsApp, "Envía mensajes y confirmaciones", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.Basededatosrelacional, "Lee y actualiza intentos_pago en PENDIENTE [QA08-04]", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, PasareladepagoYape, "Consulta el estado de cobros pendientes por clave [QA08-04]", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Aplicaciónwebprogresiva, SanCamiloenLínea.AplicaciónwebAPI.Catálogo, "Consulta productos y puestos", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Aplicaciónwebprogresiva, SanCamiloenLínea.AplicaciónwebAPI.Pedidos, "Confirma y paga pedidos", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.Aplicaciónwebprogresiva, SanCamiloenLínea.AplicaciónwebAPI.Entrega, "Consulta estado de recojo o delivery", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.AplicaciónwebAPI.Catálogo, "Consulta productos, reserva y libera stock", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.AplicaciónwebAPI.Pagos, "Solicita y registra el cobro", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Notificaciones, SanCamiloenLínea.AplicaciónwebAPI.Pedidos, "Implementa el puerto Notificador y usa PedidoPuesto", $techn="Interfaz Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Entrega, SanCamiloenLínea.AplicaciónwebAPI.Pedidos, "Consulta PedidoPuesto y registra recojo o entrega", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Catálogo, SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Utiliza tipos compartidos", $techn="Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Utiliza tipos compartidos", $techn="Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pagos, SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Utiliza tipos compartidos", $techn="Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Notificaciones, SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Utiliza tipos compartidos", $techn="Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Entrega, SanCamiloenLínea.AplicaciónwebAPI.Compartido, "Utiliza tipos compartidos", $techn="Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pagos, PasareladepagoYape, "Invoca cobrar() mediante PasarelaPago", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.Colaycaché, "Encola confirmaciones tras guardar el pedido", $techn="Protocolo Redis/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.Workerdenotificacionesyconciliación, SanCamiloenLínea.AplicaciónwebAPI.Notificaciones, "Ejecuta tareas del módulo Notificaciones", $techn="Celery/Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Notificaciones, ServiciodeWhatsApp, "Envía notificaciones del pedido", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Catálogo, SanCamiloenLínea.Basededatosrelacional, "Lee productos y stock", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.Basededatosrelacional, "Guarda pedidos y estados filtrados por mercado_id [QA08-05]", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pagos, SanCamiloenLínea.Basededatosrelacional, "Registra intentos_pago antes de cobrar [QA08-04]", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Pedidos, SanCamiloenLínea.AplicaciónwebAPI.Mercados, "Valida monto mínimo y horario del mercado [QA08-07]", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Catálogo, SanCamiloenLínea.AplicaciónwebAPI.Mercados, "Consulta el horario del mercado [QA08-07]", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.AplicaciónwebAPI.Entrega, SanCamiloenLínea.AplicaciónwebAPI.Mercados, "Consulta si hay delivery y su costo [QA08-07]", $techn="Llamada interna Python", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml