@startuml clases
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classBackgroundColor #EEF2F8
skinparam classBorderColor #1A3A5C
title San Camilo en Línea — Pedido multipuesto (diseño Lab 05 + patrones Lab 07)
skinparam nodesep 25
skinparam ranksep 40

package "catalogo" {
  class Puesto {
    - id: UUID
    - nombre: String
    - celularWhatsApp: String
  }
  class Producto {
    - id: UUID
    - nombre: String
    - precio: Decimal
    - stockDisponible: int
    + reservarStock(cantidad: int): void
    + liberarStock(cantidad: int): void
  }
}

package "pedidos" {
  class Cliente {
    - id: UUID
    - nombre: String
  }
  class Pedido {
    - id: UUID
    - fecha: DateTime
    - estado: EstadoPedido
    - modalidad: ModalidadEntrega
    + agregarLinea(producto: Producto, cantidad: int): void
    + calcularTotal(): Decimal
    + confirmar(): void
    + registrarPago(pago: Pago): void
    + dividirPorPuesto(): List<PedidoPuesto>
    + cancelar(motivo: String): void
  }
  class LineaPedido {
    - cantidad: int
    - precioUnitario: Decimal
    + subtotal(): Decimal
  }
  class PedidoPuesto {
    - id: UUID
    - estado: EstadoPedidoPuesto
    - montoDevolver: Decimal
    - motivoRechazo: String
    + calcularSubtotal(): Decimal
    + marcarListo(): void
    + registrarRecojo(): void
    + registrarEntrega(): void
    + rechazar(motivo: String): void
  }
  enum EstadoPedido {
    BORRADOR
    PAGO_PENDIENTE
    PAGADO
    CANCELADO
  }
  abstract class EstadoPedidoPuesto <<State>> {
    + marcar_listo(pedido)
    + rechazar(pedido, motivo)
    + registrar_recojo(pedido)
    + registrar_entrega(pedido)
  }
  class EstadoRecibido
  class EstadoListo
  class EstadoRecogido
  class EstadoEntregado
  class EstadoRechazado
  enum ModalidadEntrega {
    RECOJO
    DELIVERY
  }
  class PedidoController <<controlador>> {
    + pagarPedido(id: UUID, celularYape: String)
  }
  class ServicioPedidosProcesadorRefactorizado <<servicio>> {
    + confirmar_y_pagar(pedido_id, producto_id, cantidad, monto, token_tarjeta, max_reintentos, tipo_pago, puestos): dict
  }
  interface PuertoInventario <<puerto>> {
    + reservar_stock(producto_id, cantidad): bool
    + liberar_stock(producto_id, cantidad)
  }
  interface RepositorioPedidos <<puerto>> {
    + buscar(id: UUID): Pedido
    + guardar(p: Pedido): void
  }
}

package "pagos" {
  class Pago {
    - id: UUID
    - monto: Decimal
    - codigoOperacion: String
    - aprobado: bool
    - fecha: DateTime
  }
  interface PuertoPago <<Strategy>> {
    + procesar_pago(monto, token): str
  }
  class AdaptadorPasarelaPago <<Adapter>> {
    + procesar_pago(monto, token): str
  }
  class PagoFactory <<Factory>> {
    + registrar(nombre_variante, adaptador)
    + obtener(nombre_variante): PuertoPago
  }
}

package "notificaciones" {
  class PublicadorEventos <<Sujeto>> {
    + suscribir(evento, suscriptor)
    + publicar(evento, datos)
  }
  interface Suscriptor <<Observer>> {
    + actualizar(evento, datos)
  }
  class NotificadorComerciantes <<Observer concreto>>
  class AuditoriaPedidos <<Observer concreto>>
  class ConRegistroEventos <<Decorator>>
}

package "catalogo.ia" {
  interface ProveedorLLM <<Strategy>> {
    + normalizar_nombre(nombre): str
  }
  class AdaptadorClienteLLM <<Adapter>>
  class ConGuardrails <<Decorator>>
  class ConCache <<Decorator>>
  abstract class Guardrail <<Chain of Responsibility>> {
    + validar(entrada, salida): str
  }
  class GuardrailSoloNombre
  class GuardrailCatalogo
}

Cliente "1" -- "0..*" Pedido : realiza >
Pedido "1" *-- "1..*" LineaPedido
Pedido "1" *-- "0..*" PedidoPuesto
PedidoPuesto "0..1" o-- "1..*" LineaPedido
PedidoPuesto "0..*" -- "1" Puesto : atendido por >
LineaPedido "0..*" --> "1" Producto
Puesto "1" *-- "0..*" Producto : ofrece >
Pedido "1" -- "0..1" Pago : se paga con >
PedidoPuesto o--> "1" EstadoPedidoPuesto : estado_actual
EstadoPedidoPuesto <|-- EstadoRecibido
EstadoPedidoPuesto <|-- EstadoListo
EstadoPedidoPuesto <|-- EstadoRecogido
EstadoPedidoPuesto <|-- EstadoEntregado
EstadoPedidoPuesto <|-- EstadoRechazado
PuertoPago <|.. AdaptadorPasarelaPago
PagoFactory o--> "0..*" PuertoPago
PuertoPago -[hidden]down- Pago
Suscriptor <|.. NotificadorComerciantes
Suscriptor <|.. AuditoriaPedidos
Suscriptor <|.. ConRegistroEventos
ConRegistroEventos o--> "1" Suscriptor : envuelve
PublicadorEventos o--> "0..*" Suscriptor
ProveedorLLM <|.. AdaptadorClienteLLM
ProveedorLLM <|.. ConGuardrails
ProveedorLLM <|.. ConCache
ConGuardrails --> Guardrail
Guardrail <|-- GuardrailSoloNombre
Guardrail <|-- GuardrailCatalogo
PedidoController ..> ServicioPedidosProcesadorRefactorizado
ServicioPedidosProcesadorRefactorizado --> PagoFactory : fabrica_pagos
ServicioPedidosProcesadorRefactorizado --> PuertoInventario : inventario
ServicioPedidosProcesadorRefactorizado --> PublicadorEventos : publicador_eventos

note left of PedidoPuesto
  0 PedidoPuesto en BORRADOR, PAGO_PENDIENTE
  o CANCELADO (CA-2); 1..* desde PAGADO:
  dividirPorPuesto() crea uno por puesto (CA-1),
  los agrega a la composición del Pedido y los devuelve;
  cada uno agrupa las líneas que ya son del Pedido
  (cada línea: 0 PedidoPuesto antes del pago, 1 después).
end note
note bottom of Pago
  No guarda el celular de Yape del cliente:
  se pasa a cobrar() y no se persiste (R-04).
end note
note bottom of NotificadorComerciantes
  Un aviso por puesto; simula la cola
  Celery + Redis (ADR-003, QA-03).
end note
note top of ServicioPedidosProcesadorRefactorizado
  Lab 07: servicio, puertos, adaptadores,
  estados, eventos e IA existen en src/despues/
  (verificado con pyreverse). Pedido, LineaPedido,
  Producto, Puesto, Cliente, Pago, PedidoController
  y RepositorioPedidos siguen siendo diseño del Lab 05:
  el servicio aún recibe tipos simples y usa SQLite directo.
end note
@enduml
